# ── Database ───────────────────────────────────────────────
GO_DB_HOST=postgres
GO_DB_PORT=5432
GO_DB_USER=postgres
GO_DB_PASSWORD=postgres
GO_DB_NAME=go_db

# ── HTTP server ────────────────────────────────────────────
SERVER_PORT=8081

# ── Logging ────────────────────────────────────────────────
# DEBUG | INFO | WARN | ERROR
GO_LOG_LEVEL=INFO
# text | json
GO_LOG_FORMAT=text