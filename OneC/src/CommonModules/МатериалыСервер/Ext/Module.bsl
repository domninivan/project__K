Процедура ЗаполнитьТестовыеМатериалы() Экспорт

    // --- Единицы измерения: ищем по коду, добавляем только отсутствующие
    Единицы = Новый Соответствие;
    Единицы.Вставить("KG",  "Килограмм");
    Единицы.Вставить("G",   "Грамм");
    Единицы.Вставить("L",   "Литр");
    Единицы.Вставить("ML",  "Миллилитр");
    Единицы.Вставить("M",   "Метр");
    Единицы.Вставить("M2",  "Квадратный метр");
    Единицы.Вставить("M3",  "Кубический метр");
    Единицы.Вставить("PCS", "Штука");

    Для Каждого КЗ Из Единицы Цикл
        Если Справочники.ЕдиницыИзмерения.НайтиПоКоду(КЗ.Ключ).Пустая() Тогда
            Элемент = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
            Элемент.Код = КЗ.Ключ;
            Элемент.Наименование = КЗ.Значение;
            Элемент.Записать();
        КонецЕсли;
    КонецЦикла;

    // --- Материалы: единственное место, где заданы коды.
    // Если коды в Java material_code отличаются, меняйте только здесь.
    Таблица = Новый Массив;
    Таблица.Добавить(Новый Структура("Код, Наименование, Единица, Цена", "STEEL_40X",       "Сталь 40Х",           "KG",  85));
    Таблица.Добавить(Новый Структура("Код, Наименование, Единица, Цена", "BRONZE_BR02",     "Бронза БрО2",         "KG", 540));
    Таблица.Добавить(Новый Структура("Код, Наименование, Единица, Цена", "STEEL_20X",       "Сталь 20Х",           "KG",  70));
    Таблица.Добавить(Новый Структура("Код, Наименование, Единица, Цена", "STEEL_SHEET_3MM", "Сталь листовая 3 мм", "KG",  65));
    Таблица.Добавить(Новый Структура("Код, Наименование, Единица, Цена", "LUBRICANT_M01",   "Смазка М-01",         "L",  120));
    Таблица.Добавить(Новый Структура("Код, Наименование, Единица, Цена", "QUENCHING_OIL",   "Закалочное масло",    "L",  150));
    Таблица.Добавить(Новый Структура("Код, Наименование, Единица, Цена", "PAINT_BLACK",     "Краска чёрная",       "L",  210));

    Для Каждого Строка Из Таблица Цикл
        // Поиск по коду: существующие записи и их цены не трогаем
        Если Справочники.Материалы.НайтиПоКоду(Строка.Код).Пустая() Тогда
            Элемент = Справочники.Материалы.СоздатьЭлемент();
            Элемент.Код = Строка.Код;
            Элемент.Наименование = Строка.Наименование;
            Элемент.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоКоду(Строка.Единица);
            Элемент.ЦенаЗаЕдиницу = Строка.Цена;
            Элемент.Записать();
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Функция РассчитатьСтоимостьМатериала(Материал, Количество) Экспорт

    Если Не ЗначениеЗаполнено(Материал) Тогда
        ВызватьИсключение "Материал не выбран.";
    КонецЕсли;

    Если ТипЗнч(Количество) <> Тип("Число") Или Количество <= 0 Тогда
        ВызватьИсключение "Количество должно быть больше нуля.";
    КонецЕсли;

    Цена = Материал.ЦенаЗаЕдиницу;

    Возврат Окр(Количество * Цена, 2, РежимОкругления.Окр15как10);

КонецФункции