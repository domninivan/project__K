Процедура ПередЗаписью(Отказ)

    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(СокрЛП(Код)) Тогда
        Сообщить("Код материала обязателен.");
        Отказ = Истина;
    КонецЕсли;

    Если ПустаяСтрока(СокрЛП(Наименование)) Тогда
        Сообщить("Наименование материала обязательно.");
        Отказ = Истина;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
        Сообщить("Единица измерения обязательна.");
        Отказ = Истина;
    КонецЕсли;

    Если ЦенаЗаЕдиницу < 0 Тогда
        Сообщить("Цена не может быть отрицательной.");
        Отказ = Истина;
    КонецЕсли;

    Если Не Отказ Тогда
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   1
        |ИЗ
        |   Справочник.Материалы КАК М
        |ГДЕ
        |   М.Код = &Код
        |   И М.Ссылка <> &Ссылка";
        Запрос.УстановитьПараметр("Код", Код);
        Запрос.УстановитьПараметр("Ссылка", Ссылка);
        Если Не Запрос.Выполнить().Пустой() Тогда
            Сообщить("Материал с кодом " + Код + " уже существует.");
            Отказ = Истина;
        КонецЕсли;
    КонецЕсли;

КонецПроцедуры